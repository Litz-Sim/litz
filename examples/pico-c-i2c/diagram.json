    ["pico:GND.1", "lm75:A1", "black", []],
    ["pico:GND.1", "lm75:A2", "black", []],
    ["pico:GP4", "lm75:SDA", "blue", []],
    ["pico:GP5", "lm75:SCL", "yellow", []],
    ["pico:GP15", "r1:1", "green", []],
    ["r1:2", "led1:A", "green", []],
    ["led1:C", "pico:GND.2", "black", []],
