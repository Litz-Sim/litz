  "parts": [
    { "id": "pico", "type": "board-raspberry-pi-pico", "attrs": {} },
    { "id": "lm75", "type": "litz-lm75", "attrs": { "temperature": 25.0 } },
    { "id": "r1",   "type": "litz-resistor", "attrs": { "value": "330" } },
    { "id": "led1", "type": "litz-led", "attrs": { "color": "green" } }
