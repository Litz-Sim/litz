// The contract between Litz and a schematic part that is itself a WebAssembly
// component.
//
// A `part.toml` may name a wasm module instead of one of the engines built
// into Litz; this world is everything that module has to provide and
// everything it is allowed to do. The guest is loaded with no WASI, no
// filesystem, no clock and no randomness: the only way in or out is what is
// declared here.
//
// The shape mirrors `litz_core::Part` exactly. Pins are indices into the
// part's own pin table, assigned once when the board is flattened, so a guest
// never matches names at run time. Time is integer nanoseconds since the
// simulation started; there is no wall clock anywhere in this contract.
//
// 0.2.0 keeps every 0.1.0 export and adds three capability groups the catalog
// needs: bus devices (I2C/SPI/UART transactions), attributes and framebuffer
// damage for displays, and two host imports (`log`, `rom`). A 0.1.0 component
// is still accepted by the host; see `docs/formats.md` §11.
package litz:part@0.2.0;

interface types {
  /// A digital pin. `floating` means the net resolved to no driver, which is
  /// what a receiving part sees when nothing holds its pin.
  enum level {
    low,
    high,
    floating,
  }

  /// How hard a pin drives its net. `strong` is a push-pull output or a supply
  /// rail; `weak` is a resistor passing a level through.
  enum strength {
    strong,
    weak,
  }

  /// What one pin is doing to its net. `level` is `floating` when the part is
  /// not driving; `strength` is then meaningless.
  record drive {
    level: level,
    strength: strength,
  }

  /// A buzzer's current tone.
  record tone {
    sounding: bool,
    hz: u32,
  }

  /// What a UI or a test can read back without knowing the part's type. This
  /// is `litz_core::PartState`, one case per variant; `none` is a part with
  /// nothing to report (a resistor, a shift register).
  variant part-state {
    led(bool),
    button(bool),
    switch(bool),
    segments(u8),
    tone(tone),
    servo(u16),
    knob(u16),
    none,
  }

  /// The part's own description. `pins` is the pin table in the order the
  /// host assigns indices, so a guest can check itself against its manifest.
  record part-info {
    name: string,
    description: string,
    pins: list<string>,
  }

  /// One value a host UI may set on a part. Deliberately closed: a part that
  /// wants a colour or an `on`/`off` can use `text` or `flag`, and a numeric
  /// control uses `number`, so the host never parses a string it did not
  /// define.
  variant attribute-value {
    number(f64),
    text(string),
    flag(bool),
  }

  /// One attribute the part exposes. `description` is for a property editor;
  /// `value` is the current value and doubles as the default before anything
  /// calls `set-attribute`.
  record attribute-def {
    name: string,
    description: string,
    value: attribute-value,
  }

  /// The pixel geometry of a framebuffer, in pixels. A part that is not a
  /// display returns `none` from `framebuffer`.
  record framebuffer-info {
    width: u32,
    height: u32,
  }

  /// A damaged rectangle in pixels, relative to the framebuffer's top-left.
  /// `draw` accumulates these; `damage` returns and clears the pending one.
  record damage {
    x: u32,
    y: u32,
    width: u32,
    height: u32,
  }
}

/// Host services a part may call. There is no WASI in the sandbox, so these
/// are the only imports.
interface host {
  /// Append one diagnostic line. The host keeps it for the run and never
  /// feeds it back to the guest.
  log: func(message: string);

  /// The read-only image the host attached at load time. Empty when the
  /// manifest named no ROM. A part that needs factory contents reads this
  /// once, typically from `info()` or the first bus transaction.
  rom: func() -> list<u8>;
}

interface part {
  // `drive` is both a record and the name of the function that reads it; the
  // type is renamed on import so the two do not share one namespace.
  use types.{
    attribute-def,
    attribute-value,
    damage as damage-region,
    drive as drive-result,
    framebuffer-info,
    level,
    part-info,
    part-state,
  };

  /// Describe the part and its pin table. Called once when the host loads the
  /// module.
  info: func() -> part-info;

  /// A net this part is attached to resolved a level at `at-ns`.
  set-pin: func(pin: u16, level: level, at-ns: u64);

  /// Advance the part's own time to `to-ns`. Only called when a previous
  /// `next-event` named a tick at or before it.
  advance: func(to-ns: u64);

  /// The earliest tick at which this part wants `advance`. `none` means the
  /// part is purely reactive to `set-pin`.
  next-event: func() -> option<u64>;

  /// What this pin drives onto its net right now.
  drive: func(pin: u16) -> drive-result;

  /// The part's externally observable state.
  state: func() -> part-state;

  /// Host interaction: a person pressed or released the part. Returns whether
  /// the part has such an input at all.
  press: func(pressed: bool) -> bool;

  /// Host interaction: a person moved a continuous control, in permille
  /// (0 through 1000). Returns whether the part has such a control.
  set-control: func(permille: u16) -> bool;

  /// The analog voltage this pin holds, in volts. `none` for a digital pin.
  analog: func(pin: u16) -> option<f32>;

  // ------------------------------------------------------------- attributes
  //
  // A host property editor enumerates `attributes()` and writes with
  // `set-attribute`. Names are the part's own; the host does not invent them.

  attributes: func() -> list<attribute-def>;
  set-attribute: func(name: string, value: attribute-value);

  // ------------------------------------------------------------------- I2C
  //
  // The host calls these when its I2C controller addresses this part. A write
  // phase starts with `i2c-connect(addr, false)` and each controller byte
  // becomes `i2c-write`; a read phase starts with `i2c-connect(addr, true)`
  // and the host calls `i2c-read` for every byte it wants. `i2c-stop` ends the
  // transaction, including before a repeated start. Return `false` from
  // `i2c-write` to nack the byte.

  i2c-connect: func(addr: u16, read: bool);
  i2c-read: func() -> u8;
  i2c-write: func(byte: u8) -> bool;
  i2c-stop: func();

  // ------------------------------------------------------------------- SPI
  //
  // `spi-select` brackets every transaction on the part's chip select.
  // `spi-transfer` is full duplex: shift `tx` out and return exactly
  // `rx-len` bytes (the host pads a short answer with 0xff, the floating MISO
  // level).

  spi-select: func(selected: bool);
  spi-transfer: func(tx: list<u8>, rx-len: u32) -> list<u8>;

  // ------------------------------------------------------------------ UART
  //
  // `uart-receive` hands the part the bytes the chip transmitted, stamped
  // with the simulated time they arrived. `uart-poll` returns bytes the part
  // has ready for the chip; an empty list means nothing to send.

  uart-receive: func(bytes: list<u8>, at-ns: u64);
  uart-poll: func() -> list<u8>;

  // ------------------------------------------------------------- framebuffer
  //
  // A display advertises its geometry once and then receives RGBA8888 pixels
  // with `draw`. `offset` is a byte offset into the framebuffer; `pixels` has
  // no alignment requirement beyond a multiple of four for whole pixels. Each
  // `draw` updates the pending damage rectangle; `damage` returns it and
  // clears it, so a host can upload only what changed.

  framebuffer: func() -> option<framebuffer-info>;
  draw: func(offset: u32, pixels: list<u8>);
  damage: func() -> option<damage-region>;
}

world component {
  import host;
  export part;
}